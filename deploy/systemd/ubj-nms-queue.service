[Unit]
Description=UBJ Network Monitoring System - Queue Worker
After=network.target postgresql.service ubj-nms-web.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/NMS
ExecStart=/usr/bin/php /var/www/NMS/artisan queue:work --sleep=3 --tries=3
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
