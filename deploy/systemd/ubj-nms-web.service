[Unit]
Description=UBJ Network Monitoring System - Laravel Web Server
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/NMS
ExecStart=/usr/bin/php /var/www/NMS/artisan serve --host=0.0.0.0 --port=8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
